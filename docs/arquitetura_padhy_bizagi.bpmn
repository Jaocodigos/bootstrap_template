      <bpmndi:BPMNShape id="Task_CreateQueue_di" bpmnElement="Task_CreateQueue"><dc:Bounds x="1120" y="545" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RegisterItem_di" bpmnElement="Task_RegisterItem"><dc:Bounds x="1120" y="635" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateItem_di" bpmnElement="Task_UpdateItem"><dc:Bounds x="1870" y="585" width="150" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendEmail_di" bpmnElement="Task_SendEmail"><dc:Bounds x="2070" y="585" width="120" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_di" bpmnElement="EndEvent"><dc:Bounds x="2150" y="662" width="36" height="36"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ReadPadhy_di" bpmnElement="Task_ReadPadhy"><dc:Bounds x="1320" y="740" width="150" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RegisterPadhy_di" bpmnElement="Task_RegisterPadhy"><dc:Bounds x="1510" y="740" width="150" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdatePadhy_di" bpmnElement="Task_UpdatePadhy"><dc:Bounds x="1870" y="740" width="150" height="70"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Bootstrap_di" bpmnElement="Task_Bootstrap"><dc:Bounds x="1660" y="870" width="140" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidateParams_di" bpmnElement="Task_ValidateParams"><dc:Bounds x="1840" y="870" width="150" height="70"/></bpmndi:BPMNShape>
