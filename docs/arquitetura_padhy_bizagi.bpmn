      <bpmndi:BPMNShape id="Task_Authenticate_di" bpmnElement="Task_Authenticate"><dc:Bounds x="1100" y="430" width="180" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ManagedIdentity_di" bpmnElement="Task_ManagedIdentity"><dc:Bounds x="1350" y="430" width="180" height="70"/></bpmndi:BPMNShape>

