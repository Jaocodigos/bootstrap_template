      <bpmndi:BPMNEdge id="F24_di" bpmnElement="F24"><di:waypoint x="1570" y="940"/><di:waypoint x="1570" y="970"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F25_di" bpmnElement="F25"><di:waypoint x="1740" y="1005"/><di:waypoint x="1640" y="1005"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F26_di" bpmnElement="F26"><di:waypoint x="1500" y="1005"/><di:waypoint x="1450" y="1005"/></bpmndi:BPMNEdge>
