<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
 id="Definitions_PadhyInfra"
 targetNamespace="http://padhy.local/bpmn">

  <collaboration id="Collaboration_Padhy">
    <participant id="Participant_Padhy" name="Arquitetura de Infraestrutura e Execução - Padhy" processRef="Process_Padhy"/>
  </collaboration>

  <process id="Process_Padhy" name="Arquitetura de Infraestrutura e Execução - Padhy" isExecutable="false">

    <laneSet id="LaneSet_Architecture">

      <lane id="Lane_Users" name="USUÁRIOS">
        <flowNodeRef>StartEvent</flowNodeRef>
        <flowNodeRef>Task_Access</flowNodeRef>
      </lane>

      <lane id="Lane_Cloudflare" name="CLOUDFLARE - WAF / CDN">
        <flowNodeRef>Task_Cloudflare</flowNodeRef>
      </lane>

      <lane id="Lane_AKS" name="AKS / NAMESPACE">
        <flowNodeRef>Task_Portal</flowNodeRef>
        <flowNodeRef>Task_Backend</flowNodeRef>
      </lane>

      <lane id="Lane_Identity" name="SEGURANÇA E IDENTIDADE - MICROSOFT ENTRA ID">
        <flowNodeRef>Task_Authenticate</flowNodeRef>
        <flowNodeRef>Task_ManagedIdentity</flowNodeRef>
      </lane>

      <lane id="Lane_AA" name="AUTOMATION ANYWHERE">
        <flowNodeRef>Task_StartBot</flowNodeRef>
        <flowNodeRef>Task_CheckQueue</flowNodeRef>
        <flowNodeRef>Gateway_Queue</flowNodeRef>
        <flowNodeRef>Task_CreateQueue</flowNodeRef>
        <flowNodeRef>Task_RegisterItem</flowNodeRef>
        <flowNodeRef>Task_UpdateItem</flowNodeRef>
        <flowNodeRef>Task_SendEmail</flowNodeRef>
        <flowNodeRef>EndEvent</flowNodeRef>
      </lane>

      <lane id="Lane_Padhy" name="PADHY - CONTROLE DE PROCESSAMENTO">
        <flowNodeRef>Task_ReadPadhy</flowNodeRef>
        <flowNodeRef>Task_RegisterPadhy</flowNodeRef>
        <flowNodeRef>Task_UpdatePadhy</flowNodeRef>
      </lane>

      <lane id="Lane_Python" name="PYTHON - DEPLOYMENT / EXECUTION">
        <flowNodeRef>Task_Bootstrap</flowNodeRef>
        <flowNodeRef>Task_ValidateParams</flowNodeRef>
        <flowNodeRef>Gateway_Params</flowNodeRef>
        <flowNodeRef>Task_ReturnError</flowNodeRef>
        <flowNodeRef>Task_IdentifyBot</flowNodeRef>
        <flowNodeRef>Task_VerifyEnv</flowNodeRef>
        <flowNodeRef>Gateway_Env</flowNodeRef>
        <flowNodeRef>Task_CreateEnv</flowNodeRef>
        <flowNodeRef>Task_ValidateLibs</flowNodeRef>
        <flowNodeRef>Gateway_Libs</flowNodeRef>
        <flowNodeRef>Task_InstallReq</flowNodeRef>
        <flowNodeRef>Task_ExecuteBot</flowNodeRef>
      </lane>

      <lane id="Lane_AzureStorage" name="AZURE - STORAGE / ARTEFATOS">
        <flowNodeRef>Task_DownloadBot</flowNodeRef>
      </lane>

      <lane id="Lane_Data" name="DADOS E ARMAZENAMENTO">
        <flowNodeRef>Task_SQL</flowNodeRef>
        <flowNodeRef>Task_Blob</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="StartEvent" name="Início"/>
    <task id="Task_Access" name="Acessa o Portal / Solicita execução"/>
    <task id="Task_Cloudflare" name="WAF / CDN - Protege e encaminha acesso"/>
    <task id="Task_Portal" name="Portal Web"/>
    <task id="Task_Backend" name="Backend / API - .NET"/>
    <task id="Task_Authenticate" name="Autenticação - Microsoft Entra ID"/>
    <task id="Task_ManagedIdentity" name="Identidade de Serviço - Managed Identity"/>

    <task id="Task_StartBot" name="Inicia o Bot"/>
    <task id="Task_CheckQueue" name="Valida fila de processamento"/>
    <exclusiveGateway id="Gateway_Queue" name="Fila / item localizado?"/>
    <task id="Task_CreateQueue" name="Cria fila / item"/>
    <task id="Task_RegisterItem" name="Registra item de processamento"/>

    <task id="Task_ReadPadhy" name="Consulta item no Padhy"/>
    <task id="Task_RegisterPadhy" name="Registra execução no Padhy"/>

    <task id="Task_Bootstrap" name="Executa Bootstrap"/>
    <task id="Task_ValidateParams" name="Valida parâmetros de entrada"/>
    <exclusiveGateway id="Gateway_Params" name="Parâmetros válidos?"/>
    <task id="Task_ReturnError" name="Retorna informação de erro"/>
    <task id="Task_IdentifyBot" name="Identifica o Bot"/>
    <task id="Task_VerifyEnv" name="Verifica ambiente virtual"/>
    <exclusiveGateway id="Gateway_Env" name="Ambiente existe?"/>
    <task id="Task_CreateEnv" name="Cria ambiente específico"/>
    <task id="Task_ValidateLibs" name="Valida bibliotecas"/>
    <exclusiveGateway id="Gateway_Libs" name="Bibliotecas existem?"/>
    <task id="Task_InstallReq" name="Instala Requirements"/>
    <task id="Task_ExecuteBot" name="Executa Bot"/>

    <task id="Task_DownloadBot" name="Baixa Bot Atualizado"/>
    <task id="Task_SQL" name="SQL Server - Fila / Status / Auditoria"/>
    <task id="Task_Blob" name="Azure Blob Storage - Bots / Pacotes / Artefatos"/>

    <task id="Task_UpdatePadhy" name="Atualiza item / status no Padhy"/>
    <task id="Task_UpdateItem" name="Atualiza status do processamento"/>
    <task id="Task_SendEmail" name="Envia e-mail com status"/>
    <endEvent id="EndEvent" name="Fim"/>

    <dataStoreReference id="DS_SQL" name="SQL Server" dataStoreRef="DS_SQL_DEF"/>
    <dataStoreReference id="DS_BLOB" name="Azure Blob Storage" dataStoreRef="DS_BLOB_DEF"/>
    <dataStoreReference id="DS_ENTRA" name="Microsoft Entra ID" dataStoreRef="DS_ENTRA_DEF"/>

    <dataStore id="DS_SQL_DEF" name="SQL Server - Dados transacionais / status / auditoria"/>
    <dataStore id="DS_BLOB_DEF" name="Azure Blob Storage - Bots / pacotes / documentos"/>
    <dataStore id="DS_ENTRA_DEF" name="Microsoft Entra ID - SSO / Managed Identity"/>

    <!-- Main execution path -->
    <sequenceFlow id="F01" sourceRef="StartEvent" targetRef="Task_Access"/>
    <sequenceFlow id="F02" sourceRef="Task_Access" targetRef="Task_Cloudflare"/>
    <sequenceFlow id="F03" sourceRef="Task_Cloudflare" targetRef="Task_Portal"/>
    <sequenceFlow id="F04" sourceRef="Task_Portal" targetRef="Task_Authenticate"/>
    <sequenceFlow id="F05" sourceRef="Task_Authenticate" targetRef="Task_Backend"/>
    <sequenceFlow id="F06" sourceRef="Task_Backend" targetRef="Task_StartBot"/>
    <sequenceFlow id="F07" sourceRef="Task_StartBot" targetRef="Task_CheckQueue"/>
    <sequenceFlow id="F08" sourceRef="Task_CheckQueue" targetRef="Gateway_Queue"/>
    <sequenceFlow id="F09" name="Não localizado" sourceRef="Gateway_Queue" targetRef="Task_CreateQueue"/>
    <sequenceFlow id="F10" sourceRef="Task_CreateQueue" targetRef="Task_RegisterItem"/>
    <sequenceFlow id="F11" sourceRef="Task_RegisterItem" targetRef="Task_ReadPadhy"/>
    <sequenceFlow id="F12" name="Localizado" sourceRef="Gateway_Queue" targetRef="Task_ReadPadhy"/>
    <sequenceFlow id="F13" sourceRef="Task_ReadPadhy" targetRef="Task_RegisterPadhy"/>
    <sequenceFlow id="F14" sourceRef="Task_RegisterPadhy" targetRef="Task_Bootstrap"/>
    <sequenceFlow id="F15" sourceRef="Task_Bootstrap" targetRef="Task_ValidateParams"/>
    <sequenceFlow id="F16" sourceRef="Task_ValidateParams" targetRef="Gateway_Params"/>
    <sequenceFlow id="F17" name="Erro" sourceRef="Gateway_Params" targetRef="Task_ReturnError"/>
    <sequenceFlow id="F18" name="Sucesso" sourceRef="Gateway_Params" targetRef="Task_IdentifyBot"/>
    <sequenceFlow id="F19" sourceRef="Task_ReturnError" targetRef="Task_UpdatePadhy"/>
    <sequenceFlow id="F20" sourceRef="Task_IdentifyBot" targetRef="Task_DownloadBot"/>
    <sequenceFlow id="F21" sourceRef="Task_DownloadBot" targetRef="Task_VerifyEnv"/>
    <sequenceFlow id="F22" sourceRef="Task_VerifyEnv" targetRef="Gateway_Env"/>
    <sequenceFlow id="F23" name="Não existe" sourceRef="Gateway_Env" targetRef="Task_CreateEnv"/>
    <sequenceFlow id="F24" sourceRef="Task_CreateEnv" targetRef="Task_ValidateLibs"/>
    <sequenceFlow id="F25" name="Existe" sourceRef="Gateway_Env" targetRef="Task_ValidateLibs"/>
    <sequenceFlow id="F26" sourceRef="Task_ValidateLibs" targetRef="Gateway_Libs"/>
    <sequenceFlow id="F27" name="Não existem" sourceRef="Gateway_Libs" targetRef="Task_InstallReq"/>
    <sequenceFlow id="F28" sourceRef="Task_InstallReq" targetRef="Task_ExecuteBot"/>
    <sequenceFlow id="F29" name="Existem" sourceRef="Gateway_Libs" targetRef="Task_ExecuteBot"/>
    <sequenceFlow id="F30" sourceRef="Task_ExecuteBot" targetRef="Task_UpdatePadhy"/>
    <sequenceFlow id="F31" sourceRef="Task_UpdatePadhy" targetRef="Task_UpdateItem"/>
    <sequenceFlow id="F32" sourceRef="Task_UpdateItem" targetRef="Task_SendEmail"/>
    <sequenceFlow id="F33" sourceRef="Task_SendEmail" targetRef="EndEvent"/>

    <!-- Infrastructure/service relationships represented as BPMN message/data associations -->
    <association id="A01" sourceRef="Task_Authenticate" targetRef="DS_ENTRA"/>
    <association id="A02" sourceRef="Task_ManagedIdentity" targetRef="DS_ENTRA"/>
    <association id="A03" sourceRef="Task_ReadPadhy" targetRef="DS_SQL"/>
    <association id="A04" sourceRef="Task_RegisterPadhy" targetRef="DS_SQL"/>
    <association id="A05" sourceRef="Task_UpdatePadhy" targetRef="DS_SQL"/>
    <association id="A06" sourceRef="Task_DownloadBot" targetRef="DS_BLOB"/>
    <association id="A07" sourceRef="Task_Blob" targetRef="DS_BLOB"/>

  </process>

  <bpmndi:BPMNDiagram id="Diagram_Padhy">
    <bpmndi:BPMNPlane id="Plane_Padhy" bpmnElement="Collaboration_Padhy">

      <bpmndi:BPMNShape id="Participant_Padhy_di" bpmnElement="Participant_Padhy" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="2200" height="1250"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Lane_Users_di" bpmnElement="Lane_Users" isHorizontal="true">
        <dc:Bounds x="50" y="20" width="2170" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Cloudflare_di" bpmnElement="Lane_Cloudflare" isHorizontal="true">
        <dc:Bounds x="50" y="140" width="2170" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_AKS_di" bpmnElement="Lane_AKS" isHorizontal="true">
        <dc:Bounds x="50" y="260" width="2170" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Identity_di" bpmnElement="Lane_Identity" isHorizontal="true">
        <dc:Bounds x="50" y="410" width="2170" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_AA_di" bpmnElement="Lane_AA" isHorizontal="true">
        <dc:Bounds x="50" y="530" width="2170" height="180"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Padhy_di" bpmnElement="Lane_Padhy" isHorizontal="true">
        <dc:Bounds x="50" y="710" width="2170" height="130"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Python_di" bpmnElement="Lane_Python" isHorizontal="true">
        <dc:Bounds x="50" y="840" width="2170" height="220"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_AzureStorage_di" bpmnElement="Lane_AzureStorage" isHorizontal="true">
        <dc:Bounds x="50" y="1060" width="2170" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Data_di" bpmnElement="Lane_Data" isHorizontal="true">
        <dc:Bounds x="50" y="1160" width="2170" height="110"/>
      </bpmndi:BPMNShape>

      <!-- Shapes -->
      <bpmndi:BPMNShape id="StartEvent_di" bpmnElement="StartEvent"><dc:Bounds x="100" y="62" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Access_di" bpmnElement="Task_Access"><dc:Bounds x="170" y="45" width="150" height="70"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Cloudflare_di" bpmnElement="Task_Cloudflare"><dc:Bounds x="390" y="165" width="180" height="70"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Portal_di" bpmnElement="Task_Portal"><dc:Bounds x="650" y="285" width="150" height="70"/></bpmndi:BPMNShape>
