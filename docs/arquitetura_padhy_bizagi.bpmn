      <bpmndi:BPMNShape id="Task_Blob_di" bpmnElement="Task_Blob"><dc:Bounds x="1750" y="1180" width="200" height="70"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="DS_SQL_di" bpmnElement="DS_SQL"><dc:Bounds x="1660" y="1175" width="36" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_BLOB_di" bpmnElement="DS_BLOB"><dc:Bounds x="1980" y="1175" width="36" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_ENTRA_di" bpmnElement="DS_ENTRA"><dc:Bounds x="1570" y="450" width="36" height="50"/></bpmndi:BPMNShape>

      <!-- Sequence edges -->
      <bpmndi:BPMNEdge id="F01_di" bpmnElement="F01"><di:waypoint x="136" y="80"/><di:waypoint x="170" y="80"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F02_di" bpmnElement="F02"><di:waypoint x="320" y="80"/><di:waypoint x="390" y="200"/></bpmndi:BPMNEdge>
