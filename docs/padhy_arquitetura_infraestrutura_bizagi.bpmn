<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
 id="Definitions_Padhy"
 targetNamespace="http://padhy.local/bpmn">

  <collaboration id="Collaboration_Padhy">
    <participant id="Participant_Padhy"
                 name="PADHY - Automação e Infraestrutura"
                 processRef="Process_Padhy"/>
  </collaboration>

  <process id="Process_Padhy"
           name="PADHY - Execução de Bots e Infraestrutura"
           processType="None"
           isExecutable="false">

    <laneSet id="LaneSet_Padhy">

      <lane id="Lane_Usuarios" name="USUÁRIOS">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>Task_Acesso</flowNodeRef>
      </lane>

      <lane id="Lane_Cloudflare" name="CLOUDFLARE - WAF / CDN">
        <flowNodeRef>Task_Cloudflare</flowNodeRef>
      </lane>

      <lane id="Lane_AKS" name="AKS - NAMESPACE">
        <flowNodeRef>Task_Portal</flowNodeRef>
        <flowNodeRef>Task_Backend</flowNodeRef>
      </lane>

      <lane id="Lane_Identidade" name="SEGURANÇA E IDENTIDADE - ENTRA ID">
        <flowNodeRef>Task_Auth</flowNodeRef>
        <flowNodeRef>Task_ManagedIdentity</flowNodeRef>
      </lane>

      <lane id="Lane_AA" name="AUTOMATION ANYWHERE">
        <flowNodeRef>Task_IniciaBot</flowNodeRef>
        <flowNodeRef>Task_ValidaFila</flowNodeRef>
        <flowNodeRef>Gateway_Fila</flowNodeRef>
        <flowNodeRef>Task_CriaItem</flowNodeRef>
        <flowNodeRef>Task_RegistraItem</flowNodeRef>
        <flowNodeRef>Task_AtualizaItem</flowNodeRef>
        <flowNodeRef>Task_Email</flowNodeRef>
        <flowNodeRef>EndEvent_1</flowNodeRef>
      </lane>

      <lane id="Lane_Padhy" name="PADHY - CONTROLE DE PROCESSAMENTO">
        <flowNodeRef>Task_ConsultaPadhy</flowNodeRef>
        <flowNodeRef>Task_RegistraPadhy</flowNodeRef>
        <flowNodeRef>Task_AtualizaPadhy</flowNodeRef>
      </lane>

      <lane id="Lane_Python" name="PYTHON - DEPLOYMENT / EXECUÇÃO">
        <flowNodeRef>Task_Bootstrap</flowNodeRef>
        <flowNodeRef>Task_Parametros</flowNodeRef>
        <flowNodeRef>Gateway_Parametros</flowNodeRef>
        <flowNodeRef>Task_Erro</flowNodeRef>
        <flowNodeRef>Task_IdentificaBot</flowNodeRef>
        <flowNodeRef>Task_Ambiente</flowNodeRef>
        <flowNodeRef>Gateway_Ambiente</flowNodeRef>
        <flowNodeRef>Task_CriaAmbiente</flowNodeRef>
        <flowNodeRef>Task_Bibliotecas</flowNodeRef>
        <flowNodeRef>Gateway_Bibliotecas</flowNodeRef>
        <flowNodeRef>Task_Instala</flowNodeRef>
        <flowNodeRef>Task_Executa</flowNodeRef>
      </lane>

      <lane id="Lane_Azure" name="AZURE - STORAGE / ARTEFATOS">
        <flowNodeRef>Task_BaixaBot</flowNodeRef>
      </lane>

      <lane id="Lane_Dados" name="DADOS E ARMAZENAMENTO">
        <flowNodeRef>Task_SQLServer</flowNodeRef>
        <flowNodeRef>Task_BlobStorage</flowNodeRef>
      </lane>

    </laneSet>

    <startEvent id="StartEvent_1" name="Início"/>
    <task id="Task_Acesso" name="Acessa o Portal"/>
    <task id="Task_Cloudflare" name="WAF / CDN"/>
    <task id="Task_Portal" name="Portal Web - Farmácia tem Valor"/>
    <task id="Task_Backend" name="Backend .NET / API REST"/>
    <task id="Task_Auth" name="Autenticação - Entra ID"/>
    <task id="Task_ManagedIdentity" name="Managed Identity"/>

    <task id="Task_IniciaBot" name="Inicia o Bot"/>
    <task id="Task_ValidaFila" name="Valida se existe fila de processamento"/>
    <exclusiveGateway id="Gateway_Fila" name="Fila localizada?"/>
    <task id="Task_CriaItem" name="Retorna Info para criar fila"/>
    <task id="Task_RegistraItem" name="Registra Item de Processamento"/>

    <task id="Task_ConsultaPadhy" name="Consulta / Retorna item no Padhy"/>
    <task id="Task_RegistraPadhy" name="Registra Item no Padhy"/>

    <task id="Task_Bootstrap" name="Executa Bootstrap"/>
    <task id="Task_Parametros" name="Valida Parâmetros de Entrada"/>
    <exclusiveGateway id="Gateway_Parametros" name="Parâmetros válidos?"/>
    <task id="Task_Erro" name="Retorna Informação de Erro"/>
    <task id="Task_IdentificaBot" name="Identifica o Bot"/>
    <task id="Task_BaixaBot" name="Baixa Bot Atualizado - Azure"/>
    <task id="Task_Ambiente" name="Verifica Ambiente Virtual"/>
    <exclusiveGateway id="Gateway_Ambiente" name="Ambiente existe?"/>
    <task id="Task_CriaAmbiente" name="Cria Ambiente Específico"/>
    <task id="Task_Bibliotecas" name="Valida Bibliotecas"/>
    <exclusiveGateway id="Gateway_Bibliotecas" name="Bibliotecas existem?"/>
    <task id="Task_Instala" name="Instala Requirements"/>
    <task id="Task_Executa" name="Executa Bot"/>

    <task id="Task_AtualizaPadhy" name="Atualiza Item / Status no Padhy"/>
    <task id="Task_AtualizaItem" name="Atualiza Status do Processamento"/>
    <task id="Task_Email" name="Envia Email com Status"/>
    <endEvent id="EndEvent_1" name="Fim"/>

    <task id="Task_SQLServer" name="SQL Server - Dados, Fila, Status e Auditoria"/>
    <task id="Task_BlobStorage" name="Azure Blob Storage - Bots, Pacotes e Artefatos"/>

    <sequenceFlow id="Flow_01" sourceRef="StartEvent_1" targetRef="Task_Acesso"/>
    <sequenceFlow id="Flow_02" sourceRef="Task_Acesso" targetRef="Task_Cloudflare"/>
    <sequenceFlow id="Flow_03" sourceRef="Task_Cloudflare" targetRef="Task_Portal"/>
    <sequenceFlow id="Flow_04" sourceRef="Task_Portal" targetRef="Task_Auth"/>
    <sequenceFlow id="Flow_05" sourceRef="Task_Auth" targetRef="Task_Backend"/>
    <sequenceFlow id="Flow_06" sourceRef="Task_Backend" targetRef="Task_IniciaBot"/>
    <sequenceFlow id="Flow_07" sourceRef="Task_IniciaBot" targetRef="Task_ValidaFila"/>
    <sequenceFlow id="Flow_08" sourceRef="Task_ValidaFila" targetRef="Gateway_Fila"/>
    <sequenceFlow id="Flow_09" name="Não localizado" sourceRef="Gateway_Fila" targetRef="Task_CriaItem"/>
    <sequenceFlow id="Flow_10" sourceRef="Task_CriaItem" targetRef="Task_RegistraItem"/>
    <sequenceFlow id="Flow_11" sourceRef="Task_RegistraItem" targetRef="Task_ConsultaPadhy"/>
    <sequenceFlow id="Flow_12" name="Localizado" sourceRef="Gateway_Fila" targetRef="Task_ConsultaPadhy"/>
    <sequenceFlow id="Flow_13" sourceRef="Task_ConsultaPadhy" targetRef="Task_RegistraPadhy"/>
    <sequenceFlow id="Flow_14" sourceRef="Task_RegistraPadhy" targetRef="Task_Bootstrap"/>
    <sequenceFlow id="Flow_15" sourceRef="Task_Bootstrap" targetRef="Task_Parametros"/>
    <sequenceFlow id="Flow_16" sourceRef="Task_Parametros" targetRef="Gateway_Parametros"/>
    <sequenceFlow id="Flow_17" name="Erro" sourceRef="Gateway_Parametros" targetRef="Task_Erro"/>
    <sequenceFlow id="Flow_18" name="Sucesso" sourceRef="Gateway_Parametros" targetRef="Task_IdentificaBot"/>
    <sequenceFlow id="Flow_19" sourceRef="Task_Erro" targetRef="Task_AtualizaPadhy"/>
    <sequenceFlow id="Flow_20" sourceRef="Task_IdentificaBot" targetRef="Task_BaixaBot"/>
    <sequenceFlow id="Flow_21" sourceRef="Task_BaixaBot" targetRef="Task_Ambiente"/>
    <sequenceFlow id="Flow_22" sourceRef="Task_Ambiente" targetRef="Gateway_Ambiente"/>
    <sequenceFlow id="Flow_23" name="Não existe" sourceRef="Gateway_Ambiente" targetRef="Task_CriaAmbiente"/>
    <sequenceFlow id="Flow_24" sourceRef="Task_CriaAmbiente" targetRef="Task_Bibliotecas"/>
    <sequenceFlow id="Flow_25" name="Existe" sourceRef="Gateway_Ambiente" targetRef="Task_Bibliotecas"/>
    <sequenceFlow id="Flow_26" sourceRef="Task_Bibliotecas" targetRef="Gateway_Bibliotecas"/>
    <sequenceFlow id="Flow_27" name="Não existem" sourceRef="Gateway_Bibliotecas" targetRef="Task_Instala"/>
    <sequenceFlow id="Flow_28" sourceRef="Task_Instala" targetRef="Task_Executa"/>
    <sequenceFlow id="Flow_29" name="Existem" sourceRef="Gateway_Bibliotecas" targetRef="Task_Executa"/>
    <sequenceFlow id="Flow_30" sourceRef="Task_Executa" targetRef="Task_AtualizaPadhy"/>
    <sequenceFlow id="Flow_31" sourceRef="Task_AtualizaPadhy" targetRef="Task_AtualizaItem"/>
    <sequenceFlow id="Flow_32" sourceRef="Task_AtualizaItem" targetRef="Task_Email"/>
    <sequenceFlow id="Flow_33" sourceRef="Task_Email" targetRef="EndEvent_1"/>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Padhy">
    <bpmndi:BPMNPlane id="BPMNPlane_Padhy" bpmnElement="Collaboration_Padhy">

      <bpmndi:BPMNShape id="Participant_Padhy_di" bpmnElement="Participant_Padhy" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="2200" height="1300"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Lane_Usuarios_di" bpmnElement="Lane_Usuarios" isHorizontal="true"><dc:Bounds x="50" y="20" width="2170" height="120"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Cloudflare_di" bpmnElement="Lane_Cloudflare" isHorizontal="true"><dc:Bounds x="50" y="140" width="2170" height="120"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_AKS_di" bpmnElement="Lane_AKS" isHorizontal="true"><dc:Bounds x="50" y="260" width="2170" height="150"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Identidade_di" bpmnElement="Lane_Identidade" isHorizontal="true"><dc:Bounds x="50" y="410" width="2170" height="120"/></bpmndi:BPMNShape>
